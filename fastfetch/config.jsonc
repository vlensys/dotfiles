{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "artix_small",
    "padding": { "right": 2 }
  },
  "display": {
    "separator": " ─ ",
    "constants": [
      "─────────────────────────────────────",
      "│\u001b[37C│\u001b[37D"
    ]
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#keys}╭{$1}╮"
    },
    {
      "type": "custom",
      "format": "{#keys}│\u001b[0m            \u001b[1mvalen @ artix\u001b[0m            {#keys}│"
    },
    {
      "type": "custom",
      "format": "{#keys}├{$1}┤"
    },
    {
      "type": "os",
      "key": "{$2}{#keys}   os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "{$2}{#keys}   wm"
    },
    {
      "type": "shell",
      "key": "{$2}{#keys}   sh"
    },
    {
      "type": "packages",
      "key": "{$2}{#keys}  pkg"
    },
    {
      "type": "memory",
      "key": "{$2}{#keys}  mem",
      "format": "{used} / {total}"
    },
    {
      "type": "uptime",
      "key": "{$2}{#keys}   up"
    },
    {
      "type": "custom",
      "format": "{#keys}╰{$1}╯"
    },
    { "type": "break" },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
